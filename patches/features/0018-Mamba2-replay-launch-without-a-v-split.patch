From 51f47565a601af83630d5d091dbfdde2f5df94a9 Mon Sep 17 00:00:00 2001
From: Parth Thakre <144053824+parth-thakre@users.noreply.github.com>
Date: Mon, 12 Oct 2026 03:36:02 +0530
Subject: [PATCH 18/18] Mamba2 replay: launch without a v split

batched_scan_replay picked v_split = 4 for 128-wide v heads regardless of kind, but Mamba2 only has
V_SPLIT = 1 replay kernels (its forward launch uses no split either). The extra z blocks ran with
v_chunk_dim = v_head_dim, so blocks 1..3 started past the head's v range and updated neighbouring
heads' state. Mamba2 now launches with no split.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 exllamav3/exllamav3_ext/gdn.cu | 5 +++--
 1 file changed, 3 insertions(+), 2 deletions(-)

diff --git a/exllamav3/exllamav3_ext/gdn.cu b/exllamav3/exllamav3_ext/gdn.cu
index 7805f4c2..3f4041d3 100644
--- a/exllamav3/exllamav3_ext/gdn.cu
+++ b/exllamav3/exllamav3_ext/gdn.cu
@@ -2237,8 +2237,9 @@ void batched_scan_replay
     bool channelwise = kind == 2;
     float scale = 1.0f / sqrtf(k_head_dim);
     // One job per block.x; the batch rows of a single sequence replay serially per layer, so the
-    // v-split that keeps bsz = 1 passes occupied applies here as well
-    int v_split = (k_head_dim <= 128 && v_head_dim == 128 && num_v_heads <= 64) ? 4 : 1;
+    // v-split that keeps bsz = 1 passes occupied applies here as well. Mamba2 has only V_SPLIT = 1
+    // kernels (as in its forward launch): a z-split there would put blocks past the head's v range
+    int v_split = (!mamba2 && k_head_dim <= 128 && v_head_dim == 128 && num_v_heads <= 64) ? 4 : 1;
     dim3 threads(MAX(k_head_dim, v_head_dim / v_split), SUBK);
 
     for (size_t base = 0; base < jobs.size(); base += REPLAY_MAX_JOBS)
